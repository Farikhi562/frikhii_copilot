# FRIKHII Copilot â€” AI Engine
# Copy to services/ai-engine/.env and fill in real values. Never commit that file.

APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Shared secret used by the Go Core API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The AI Engine refuses to serve internal endpoints without it.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value

# Primary LLM Provider: "gemini", "openai-compatible", or "mock".
# AI_PROVIDER takes precedence over LLM_PROVIDER.
AI_PROVIDER=gemini

# Gemini (default real provider). Paste your key here.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

AI_MAX_OUTPUT_TOKENS=8000
AI_TEMPERATURE=0.2
AI_REQUEST_TIMEOUT=120
AI_MAX_RETRIES=2

# OpenAI-compatible alternative. Use this instead of Gemini by setting
# AI_PROVIDER=openai-compatible above, then uncomment and fill these.
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# Offline/testing only (deterministic fixture output, no API key needed):
# AI_PROVIDER=mock

# Optional explicit fallback. Leave provider empty to disable.
# Allowed: "gemini", "openai-compatible", or "mock". A mock fallback is rejected in production.
# The response metadata always states which provider was used and why.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# Guardrails
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=262144
