# FRIKHII Copilot — AI Engine
# Copy to services/ai-engine/.env and fill in real values. Never commit that file.

APP_ENV=development
HOST=127.0.0.1
PORT=8000

# Shared secret used by the Go Core API. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The AI Engine refuses to serve internal endpoints without it.
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-value

# Provider: "openai-compatible" or "mock".
# "mock" is deterministic and only allowed outside production.
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

# Structured output mode: "json_schema" (preferred where supported) or "json_object".
LLM_STRUCTURED_OUTPUT=json_object
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8000
LLM_MAX_OUTPUT_BYTES=524288
LLM_TEMPERATURE=0.2

# Optional explicit fallback. Leave provider empty to disable.
# Allowed: "openai-compatible" or "mock". A mock fallback is rejected in production.
# The response metadata always states which provider was used and why.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=

# Guardrails
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=262144
