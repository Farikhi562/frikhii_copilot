# FRIKHII Copilot — Core API (Go + Chi)
#
# The Go process reads real environment variables; it does not load this file
# automatically. Copy the names/values into your shell, process manager, or container.
# Never commit real secrets.

APP_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Supabase JWT verification. With SUPABASE_URL set, the JWKS URL and issuer are derived:
#   SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
#   SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1
# SUPABASE_JWT_SECRET is only for legacy HS256 projects. Leave it empty for ES256/JWKS.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
SUPABASE_JWT_ISSUER=

# Privileged PostgreSQL connection. Use the Supabase pooler/direct connection string.
# The service re-checks ownership in every query; RLS protects browser/PostgREST access.
DATABASE_URL=

# Python AI Engine. The shared token must match INTERNAL_SERVICE_TOKEN in the AI Engine.
AI_ENGINE_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=

# Timeouts and generation lock.
AI_TIMEOUT_SECONDS=120
AI_GENERATION_TIMEOUT_SECONDS=240
GENERATION_STALE_SECONDS=600
MAX_REQUEST_BYTES=262144

# Local tests only. main.go refuses AUTH_DISABLED in production.
# AUTH_DISABLED=false
