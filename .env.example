# Supabase browser configuration.
# Copy this file to .env.local at the repository root, then fill in the values.
# Only the publishable (anon) key belongs in the browser. Never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Go Core API base URL. Defaults to http://localhost:8080 when unset in development.
# Production builds require an explicit value.
VITE_CORE_API_URL=http://localhost:8080

# Server-side secrets are NOT VITE_* variables. See:
#   services/core-api/.env.example
#   services/ai-engine/.env.example
